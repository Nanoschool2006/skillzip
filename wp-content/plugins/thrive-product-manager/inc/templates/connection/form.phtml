<?php
/** @var TPM_Connection $this */
/** @var string $login_url */
$login_url = $this->get_login_url();

// After a deactivation-driven disconnect, explain what happened and what to do (set in reconcile_active_license()).
$disconnect_cause     = class_exists( 'TPM_License_Manager' ) ? TPM_License_Manager::get_instance()->get_disconnect_notice() : '';
$tpm_manage_sites_url = 'https://thrivethemes.com/account/licenses/';
$tpm_pricing_url      = 'https://thrivethemes.com/pricing/';
?>
	<div class="tpm-connect-screen">
		<div>
			<?php if ( $disconnect_cause ) : ?>
				<div class="tpm-connect-notice tpm-connect-notice--<?php echo esc_attr( $disconnect_cause ); ?>">
					<?php if ( 'no_license' === $disconnect_cause ) : ?>
						<h2><?php echo __( 'No Thrive license covers this site', Thrive_Product_Manager::T ); ?></h2>
						<p><?php echo __( 'Your Thrive Themes account doesn’t have a license available for this website, so the Product Manager has disconnected.', Thrive_Product_Manager::T ); ?></p>
						<p><?php echo sprintf( __( 'To install Thrive products here, %s, then log in to connect.', Thrive_Product_Manager::T ), '<a href="' . $tpm_pricing_url . '" target="_blank">' . __( 'get a license', Thrive_Product_Manager::T ) . '</a>' ); ?></p>
					<?php elseif ( 'seat_full' === $disconnect_cause ) : ?>
						<h2><?php echo __( 'This site’s Thrive license is no longer active', Thrive_Product_Manager::T ); ?></h2>
						<p><?php echo __( 'This website was deactivated on your Thrive license, and that license is already at its site limit.', Thrive_Product_Manager::T ); ?></p>
						<p><?php echo sprintf( __( 'To use Thrive products here, %1$s another site to free up a seat then reactivate this one — or %2$s — then log in to reconnect.', Thrive_Product_Manager::T ), '<a href="' . $tpm_manage_sites_url . '" target="_blank">' . __( 'deactivate', Thrive_Product_Manager::T ) . '</a>', '<a href="' . $tpm_pricing_url . '" target="_blank">' . __( 'get a new license', Thrive_Product_Manager::T ) . '</a>' ); ?></p>
					<?php else : // 'reactivate' ?>
						<h2><?php echo __( 'This site’s Thrive license is no longer active', Thrive_Product_Manager::T ); ?></h2>
						<p><?php echo __( 'The Thrive license this website was using has been deactivated in your Thrive Themes account, so the Product Manager has disconnected.', Thrive_Product_Manager::T ); ?></p>
						<p><?php echo sprintf( __( 'To use Thrive products here again, %1$s this site, then log in to reconnect. Don’t need that license anymore? %2$s.', Thrive_Product_Manager::T ), '<a href="' . $tpm_manage_sites_url . '" target="_blank">' . __( 'reactivate', Thrive_Product_Manager::T ) . '</a>', '<a href="' . $tpm_pricing_url . '" target="_blank">' . __( 'get a new license', Thrive_Product_Manager::T ) . '</a>' ); ?></p>
					<?php endif; ?>
				</div>

				<hr class="tpm-le-rule"/>
			<?php else : ?>
				<h2><?php echo __( 'Connect to ThriveThemes.com to access your product.', Thrive_Product_Manager::T ) ?></h2>
				<p><?php echo __( 'Click on the button below to be taken to Thrive Themes and simply log into your account to install your product', Thrive_Product_Manager::T ) ?></p>
				<p><?php echo __( 'Make sure that you use the same username and password that used when signing up at ThriveThemes.com', Thrive_Product_Manager::T ) ?></p>

				<hr class="tpm-le-rule"/>
			<?php endif; ?>

			<a class="tpm-login" href="<?php echo $login_url; ?>">
				<?php echo __( 'Log into my account', Thrive_Product_Manager::T ) ?>
			</a>

			<p>
				<a href="https://thrivethemes.com/docs/installing-a-thrive-themes-plugin/"
				   target="_blank"><?php echo __( 'See how it works.', Thrive_Product_Manager::T ) ?></a>
			</p>

		</div>
	</div>
<?php include thrive_product_manager()->path( 'inc/templates/debugger.phtml' ) ?>
